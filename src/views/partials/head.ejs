<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title><%= title %> · SkillMart</title>
  <meta name="robots" content="<%= seo ? seo.robots : 'noindex' %>">
  <% if (seo) { %>
  <meta name="description" content="<%= seo.description %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  <meta property="og:title" content="<%= seo.title %> · SkillMart">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= seo.canonical %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= seo.title %> · SkillMart">
  <meta name="twitter:description" content="<%= seo.description %>">
  <% } %>
  <script src="/assets/js/theme-init.js"></script>
  <link rel="stylesheet" href="/assets/css/app.css">
  <script src="/assets/js/forms.js" defer></script>
  <script src="/assets/js/theme.js" defer></script>
  <script src="/assets/js/copy.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
   <a class="brand" href="/" aria-label="SkillMart home"><span class="brand-mark" aria-hidden="true">✳</span>SkillMart<span class="label">THE SKILL COMMONS</span></a>
  <nav aria-label="Main navigation">
    <a href="/skills">Browse skills</a>
    <% if (user) { %>
      <a href="/dashboard">Workspace</a>
      <% if (user.role === 'admin') { %><a href="/admin">Administration</a><% } %>
      <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary" type="submit">Sign out</button></form>
    <% } else { %>
       <a href="/login">Sign in</a><a class="nav-cta" href="/register">Get started <span aria-hidden="true">↗</span></a>
    <% } %>
  </nav>
  <div class="theme-control" data-theme-control hidden>
    <label for="theme">Theme</label>
    <select id="theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select>
  </div>
</header>
<main id="main" tabindex="-1">
<% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
