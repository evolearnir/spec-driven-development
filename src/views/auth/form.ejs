<%- include('../partials/head') %>
<div class="auth-layout">
  <aside class="intro-panel" aria-label="About SkillMart">
    <span class="intro-symbol" aria-hidden="true">✳</span>
    <p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
    <h2>Human insight.<br><span class="accent-text">Open possibilities.</span></h2>
    <p class="lead muted">A home for the little workflows that make a big difference. Find your people. Discover your next skill.</p>
    <div class="auth-benefits"><div><span aria-hidden="true">01</span><p><strong>Explore freely.</strong><br>Read and copy public instruction packages.</p></div><div><span aria-hidden="true">02</span><p><strong>Make it your own.</strong><br>Bring better instructions to your AI workflow.</p></div></div>
    <p class="foundation-note">Creator editing and publishing arrive in Phase 3.</p>
  </aside>
  <section class="card auth-card">
    <p class="eyebrow">YOUR ACCOUNT</p>
    <h1><%= title %></h1>
    <p class="muted"><%= intro %></p>
    <% if (Object.keys(errors).length) { %>
      <div class="errors" role="alert" tabindex="-1" data-error-summary aria-labelledby="error-title">
        <h2 id="error-title">Please check your submission</h2>
        <ul><% for (const [field, error] of Object.entries(errors)) { %><li><% if (field === 'form') { %><%= error %><% } else { %><a href="#<%= field %>"><%= error %></a><% } %></li><% } %></ul>
      </div>
    <% } %>
    <form action="/<%= page %>" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% for (const field of fields) { const isPassword = field === 'password'; const label = field === 'displayName' ? 'Display name' : field === 'email' ? 'Email address' : 'Password'; %>
        <div class="field">
          <label for="<%= field %>"><%= label %></label>
          <input id="<%= field %>" name="<%= field %>" type="<%= isPassword ? 'password' : field === 'email' ? 'email' : 'text' %>" required
            maxlength="<%= isPassword ? 128 : field === 'email' ? 254 : 80 %>"
            <% if (isPassword && page !== 'login') { %>minlength="12"<% } %>
            autocomplete="<%= isPassword ? (page === 'login' ? 'current-password' : 'new-password') : field === 'email' ? 'email' : 'nickname' %>"
            <% if (!isPassword) { %>value="<%= values[field] || '' %>"<% } %>
            aria-invalid="<%= errors[field] ? 'true' : 'false' %>"
            <% if (errors[field] || (isPassword && page !== 'login')) { %>aria-describedby="<%= errors[field] ? field + '-error' : 'password-help' %>"<% } %>>
          <% if (isPassword && page !== 'login') { %><p id="password-help" class="helper">Use 12–128 characters. Password managers and paste are welcome.</p><% } %>
          <% if (errors[field]) { %><p id="<%= field %>-error" class="field-error"><%= errors[field] %></p><% } %>
        </div>
      <% } %>
      <% if (fields.includes('password')) { %><button class="text-button" type="button" data-password-toggle aria-controls="password" aria-pressed="false">Show password</button><% } %>
      <button class="primary" type="submit"><%= button %></button>
    </form>
    <div class="form-links">
      <% if (page === 'login') { %><a href="/forgot-password">Forgot your password?</a><a href="/register">New here? Create an account</a><% } else { %><a href="/login">Back to sign in</a><% } %>
      <% if (page === 'verify-email') { %><p class="helper">Need another link? Sign in and resend from your workspace.</p><% } %>
      <% if (page === 'reset-password') { %><a href="/forgot-password">Request a new reset link</a><% } %>
    </div>
  </section>
</div>
<%- include('../partials/footer') %>
