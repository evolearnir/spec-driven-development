NODE_ENV=development
# Development verification skips SMTP and prints the code/link in the terminal.
# Password recovery still uses SMTP; production verification also uses SMTP.
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/development.sqlite
# Generate privately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
TRUST_PROXY=0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SkillMart <noreply@example.test>
# Set these only for the protected bootstrap operation; remove afterward.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_EMAIL_VERIFIED=false
BACKUP_DIR=./backups
SEED_ENABLED=false
